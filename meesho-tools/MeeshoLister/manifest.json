{
  "manifest_version": 3,
  "name": "Meesho Auto Lister",
  "version": "1.0",
  "description": "Fill Meesho product listing form from a saved record.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://seller.meesho.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meesho Auto Lister"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://seller.meesho.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}